void sendcodetofile(vector <stcustomers>& vcustomers, stcustomers& customers, fstream& newfile, string& txt) {

	string s;
	newfile.open(txt, ios::out);
	for (stcustomers customers : vcustomers) {
		if (customers.accontnumber != "") {
			s = customers.accontnumber + "#//#" + customers.pincode + "#//#" + customers.name + "#//#" + customers.phone + "#//#" + to_string(customers.balance) + "\n";

			if (newfile.is_open())
				newfile << s;
		}
	}
	newfile.close();
}

void senduserstofile(vector <stusers>& vusers,fstream& fusers, string& txtusers) {

