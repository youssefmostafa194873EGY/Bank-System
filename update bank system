	}

	return vcustomers;
}

vector <stusers> PrintEachWordInString(string& delim, vector <stusers>& vusers, stusers& users, vector <string>& vsusers){



	for (string user : vsusers) {

		users.name = full(user, delim);
		users.password = full(user, delim);
		users.permissions = stoi(full(user, delim));


