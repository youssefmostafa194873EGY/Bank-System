void SaveVectorToFile(fstream& newfile,string FileName, vector <string>vFileContent)
{
	
	newfile.open(FileName, ios::out);
	if (newfile.is_open())
	{
		for (string Line : vFileContent)
		{
			if (Line != "")
			{
				newfile << Line << endl;
			}
		}
		newfile.close();
	}
}

string full(string &s1, string delim) {
	int pos = 0;
	string sWord = "";

	pos = s1.find(delim);
	sWord = s1.substr(0, pos);
	
	s1.erase(0, pos + delim.length());
	return sWord;
}




vector <stcustomers> PrintEachWordInString(string &delim, vector <stcustomers> &vcustomers,stcustomers &customers, vector <string> &vscustomers)
{
	
	
	
	for (string scustomers : vscustomers){

		
		customers.accontnumber = full(scustomers, delim);
		
		
		customers.pincode = full(scustomers, delim);
		
		customers.name = full(scustomers, delim);
		
		customers.phone = full(scustomers, delim);
		
		customers.balance = stoi(full(scustomers, delim));
		
		
		vcustomers.push_back(customers);
		
	}
	
		return vcustomers;
}



